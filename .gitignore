# Custom user scripts and configuration
# custom/* (not custom/): excluding the directory itself would make the
# re-includes below impossible - git never re-includes inside an excluded dir.
custom/*
!custom/repo.yaml
!custom/demo-scripts/
custom.yaml

# Logs
logs/
*.log

# Temporary files
.DS_Store
*.swp
*.swo
*~

# Node modules (if ever needed)
node_modules/
FETCH_HEAD
